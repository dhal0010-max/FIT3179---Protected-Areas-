{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 650,
  "height": 400,
  "title": {
    "text": "Australian Terrestrial Protected Area Coverage by State (%)",
    "fontSize": 15,
    "font": "Segoe UI"
  },
  "data": {
    "url": "australia-states.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {"url": "state_protection.csv"},
        "key": "state",
        "fields": ["pct", "area_ha", "code"]
      }
    }
  ],
  "projection": {"type": "mercator", "center": [133, -27], "scale": 650},
  "mark": {"type": "geoshape", "stroke": "#ffffff", "strokeWidth": 1.2},
  "encoding": {
    "color": {
      "field": "pct",
      "type": "quantitative",
      "title": "Protected (%)",
      "scale": {"scheme": "greens"},
      "legend": {"orient": "right", "title": "Protected (%)"}
    },
    "tooltip": [
      {"field": "properties.name", "type": "nominal", "title": "Jurisdiction"},
      {"field": "pct", "type": "quantitative", "title": "Protected Area (%)", "format": ".1f"},
      {"field": "area_ha", "type": "quantitative", "title": "Area (ha)", "format": ","}
    ]
  }
}